//@version=6
indicator("EQ Engine — Classic Levels", overlay = true, max_lines_count = 500)

// ---------------------------------------------------------------------------
// Constants
// ---------------------------------------------------------------------------

SUPPORT = 1
RESISTANCE = -1

LEVEL_TYPE_CLASSIC = "Classic"

COLOR_SUPPORT = color.teal
COLOR_RESISTANCE = color.orange

LINE_XLOC = xloc.bar_index
LINE_EXTEND = extend.right
LINE_STYLE = line.style_solid
LINE_WIDTH = 1

// ---------------------------------------------------------------------------
// Candle classification (02_Engine.md §3)
// ---------------------------------------------------------------------------

isBullCandle(float o, float c) =>
    c > o

isBearCandle(float o, float c) =>
    c < o

isDojiCandle(float o, float c) =>
    c == o

// ---------------------------------------------------------------------------
// Level
// ---------------------------------------------------------------------------

type Level
    int id
    float price
    int direction
    string levelType
    bool fresh
    bool valid
    int creationBar
    line levelLine

var array<Level> allLevels = array.new<Level>()
var int nextLevelId = 0

// ---------------------------------------------------------------------------
// detectClassic — two adjacent opposite-direction candles; ignore Doji
// Returns: [detected, price, direction]
// ---------------------------------------------------------------------------

detectClassic() =>
    bool detected = false
    float levelPrice = na
    int direction = 0

    bool firstDoji = isDojiCandle(open[1], close[1])
    bool secondDoji = isDojiCandle(open, close)

    if not firstDoji and not secondDoji
        if isBearCandle(open[1], close[1]) and isBullCandle(open, close)
            detected := true
            levelPrice := close[1]
            direction := SUPPORT
        else if isBullCandle(open[1], close[1]) and isBearCandle(open, close)
            detected := true
            levelPrice := close[1]
            direction := RESISTANCE

    [detected, levelPrice, direction]

// ---------------------------------------------------------------------------
// createLevel — build a confirmed Classic Level
// ---------------------------------------------------------------------------

createLevel(int id, float price, int direction) =>
    Level.new(
         id,
         price,
         direction,
         LEVEL_TYPE_CLASSIC,
         true,
         true,
         bar_index,
         na)

// ---------------------------------------------------------------------------
// drawLevels — draw every stored level that has no line yet
// ---------------------------------------------------------------------------

drawLevels() =>
    for i = 0 to array.size(allLevels) - 1
        lvl = array.get(allLevels, i)
        if na(lvl.levelLine)
            lineColor = lvl.direction == SUPPORT ? COLOR_SUPPORT : COLOR_RESISTANCE
            ln = line.new(
                 lvl.creationBar,
                 lvl.price,
                 lvl.creationBar + 1,
                 lvl.price,
                 xloc = LINE_XLOC,
                 extend = LINE_EXTEND,
                 color = lineColor,
                 style = LINE_STYLE,
                 width = LINE_WIDTH)
            lvl.levelLine := ln
            array.set(allLevels, i, lvl)

// ---------------------------------------------------------------------------
// Main — confirmed only after the second candle closes
// ---------------------------------------------------------------------------

if barstate.isconfirmed
    [detected, levelPrice, direction] = detectClassic()
    if detected
        array.push(allLevels, createLevel(nextLevelId, levelPrice, direction))
        nextLevelId += 1

drawLevels()
