//@version=6
indicator("EQ Engine", overlay = true, max_lines_count = 500, max_labels_count = 500)

// ---------------------------------------------------------------------------
// Constants
// ---------------------------------------------------------------------------

const int LINE_END_OFFSET = 1
const int LINE_DISPLAY_OFFSET = 17
const int TEXT_LABEL_OFFSET = 18
const int FIRST_LEVEL_ID = 0
const int INDEX_STEP = 1
const int INDEX_NOT_FOUND = -1

const bool INITIAL_FRESH = true
const bool INITIAL_VALID = true
const bool INITIAL_BO_CREATED = false
const bool INITIAL_HNS_CREATED = false

const color SUPPORT_COLOR = color.rgb(0, 136, 122)
const color RESISTANCE_COLOR = color.rgb(125, 75, 0)

const int LEVEL_LINE_WIDTH = 1

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

const int SUPPORT = 1
const int RESISTANCE = -1

const int LEVEL_CLASSIC = 1
const int LEVEL_GAP = 2
const int LEVEL_BO = 3
const int LEVEL_HNS = 4

// ---------------------------------------------------------------------------
// Data Model
// ---------------------------------------------------------------------------

type Level
    int id
    float price
    int direction
    int creationBar
    int levelType
    bool fresh
    bool valid
    bool boCreated
    bool hnsCreated

// ---------------------------------------------------------------------------
// Candle Functions
// ---------------------------------------------------------------------------

isBullCandle(float candleOpen, float candleClose) =>
    candleClose > candleOpen

isBearCandle(float candleOpen, float candleClose) =>
    candleClose < candleOpen

isDojiCandle(float candleOpen, float candleClose) =>
    candleClose == candleOpen

// ---------------------------------------------------------------------------
// Detector
// ---------------------------------------------------------------------------

detectClassic() =>
    bool detected = false
    float levelPrice = na
    int direction = na
    int levelType = LEVEL_CLASSIC

    if bar_index > 0
        bool previousDoji = isDojiCandle(open[1], close[1])
        bool currentDoji = isDojiCandle(open, close)

        if not previousDoji and not currentDoji
            bool supportDetected = isBearCandle(open[1], close[1]) and isBullCandle(open, close)
            bool resistanceDetected = isBullCandle(open[1], close[1]) and isBearCandle(open, close)

            if supportDetected
                detected := true
                levelPrice := close[1]
                direction := SUPPORT
                levelType := LEVEL_CLASSIC
            else if resistanceDetected
                detected := true
                levelPrice := close[1]
                direction := RESISTANCE
                levelType := LEVEL_CLASSIC

    [detected, levelPrice, direction, levelType]

detectGap() =>
    bool detected = false
    float levelPrice = na
    int direction = na
    int levelType = LEVEL_GAP

    if bar_index > 0
        bool previousDoji = isDojiCandle(open[1], close[1])
        bool currentDoji = isDojiCandle(open, close)

        if not previousDoji and not currentDoji
            bool supportDetected = isBullCandle(open[1], close[1]) and isBullCandle(open, close)
            bool resistanceDetected = isBearCandle(open[1], close[1]) and isBearCandle(open, close)

            if supportDetected
                detected := true
                levelPrice := close[1]
                direction := SUPPORT
            else if resistanceDetected
                detected := true
                levelPrice := close[1]
                direction := RESISTANCE

    [detected, levelPrice, direction, levelType]

isLevelTouched(Level level) =>
    high >= level.price and low <= level.price

isLevelBroken(Level level) =>
    bool broken = false

    if level.direction == SUPPORT
        broken := close < level.price
    else if level.direction == RESISTANCE
        broken := close > level.price

    broken

isLevelRejected(Level level) =>
    isLevelTouched(level) and not isLevelBroken(level)

isBOCandidate(Level level) =>
    level.levelType == LEVEL_CLASSIC and not level.boCreated and bar_index > level.creationBar

detectBO(array<Level> levels, array<int> boCandidates, array<float> boPrices, array<int> boDirections, array<int> boSourceIndexes, array<int> boCreationBars) =>
    array.clear(boPrices)
    array.clear(boDirections)
    array.clear(boSourceIndexes)
    array.clear(boCreationBars)

    int candidateCount = array.size(boCandidates)

    if candidateCount > 0
        for candidateIndex = FIRST_LEVEL_ID to candidateCount - INDEX_STEP
            int levelIndex = array.get(boCandidates, candidateIndex)
            Level level = array.get(levels, levelIndex)

            if isBOCandidate(level)
                if level.direction == SUPPORT and isLevelBroken(level)
                    array.push(boPrices, level.price)
                    array.push(boDirections, RESISTANCE)
                    array.push(boSourceIndexes, levelIndex)
                    array.push(boCreationBars, bar_index)
                else if level.direction == RESISTANCE and isLevelBroken(level)
                    array.push(boPrices, level.price)
                    array.push(boDirections, SUPPORT)
                    array.push(boSourceIndexes, levelIndex)
                    array.push(boCreationBars, bar_index)

    array.size(boPrices)

isHNSCandidate(Level level) =>
    level.levelType == LEVEL_BO and not level.hnsCreated and bar_index > level.creationBar

isSupportBOBrokenForHNS(Level level) =>
    isLevelBroken(level)

isResistanceBOBrokenForHNS(Level level) =>
    isLevelBroken(level)

detectHNS(array<Level> levels, array<int> hnsCandidates, array<float> hnsPrices, array<int> hnsDirections, array<int> hnsSourceIndexes, array<int> hnsCreationBars) =>
    array.clear(hnsPrices)
    array.clear(hnsDirections)
    array.clear(hnsSourceIndexes)
    array.clear(hnsCreationBars)

    int candidateCount = array.size(hnsCandidates)

    if candidateCount > 0
        for candidateIndex = FIRST_LEVEL_ID to candidateCount - INDEX_STEP
            int levelIndex = array.get(hnsCandidates, candidateIndex)
            Level level = array.get(levels, levelIndex)

            if isHNSCandidate(level)
                if level.direction == SUPPORT and isSupportBOBrokenForHNS(level)
                    array.push(hnsPrices, level.price)
                    array.push(hnsDirections, RESISTANCE)
                    array.push(hnsSourceIndexes, levelIndex)
                    array.push(hnsCreationBars, bar_index)
                else if level.direction == RESISTANCE and isResistanceBOBrokenForHNS(level)
                    array.push(hnsPrices, level.price)
                    array.push(hnsDirections, SUPPORT)
                    array.push(hnsSourceIndexes, levelIndex)
                    array.push(hnsCreationBars, bar_index)

    array.size(hnsPrices)

// ---------------------------------------------------------------------------
// Creation
// ---------------------------------------------------------------------------

createLevel(int levelId, float levelPrice, int direction, int levelType, int creationBar) =>
    Level.new(
         levelId,
         levelPrice,
         direction,
         creationBar,
         levelType,
         INITIAL_FRESH,
         INITIAL_VALID,
         INITIAL_BO_CREATED,
         INITIAL_HNS_CREATED)

// ---------------------------------------------------------------------------
// Level Manager
// ---------------------------------------------------------------------------

var array<Level> allLevels = array.new<Level>()
var array<int> freshCandidateIndexes = array.new<int>()
var array<int> boCandidateIndexes = array.new<int>()
var array<float> boCreationPrices = array.new<float>()
var array<int> boCreationDirections = array.new<int>()
var array<int> boCreationSourceIndexes = array.new<int>()
var array<int> boCreationBars = array.new<int>()
var array<int> hnsCandidateIndexes = array.new<int>()
var array<float> hnsCreationPrices = array.new<float>()
var array<int> hnsCreationDirections = array.new<int>()
var array<int> hnsCreationSourceIndexes = array.new<int>()
var array<int> hnsCreationBars = array.new<int>()
var array<int> dirtyRenderIndexes = array.new<int>()
var int nextId = FIRST_LEVEL_ID

queueFreshCandidate(int levelIndex) =>
    array.push(freshCandidateIndexes, levelIndex)

queueBOCandidate(int levelIndex) =>
    array.push(boCandidateIndexes, levelIndex)

queueHNSCandidate(int levelIndex) =>
    array.push(hnsCandidateIndexes, levelIndex)

queueDirtyRender(int levelIndex) =>
    if not array.includes(dirtyRenderIndexes, levelIndex)
        array.push(dirtyRenderIndexes, levelIndex)

removeFreshCandidate(int levelIndex) =>
    int candidateIndex = array.indexof(freshCandidateIndexes, levelIndex)

    if candidateIndex != INDEX_NOT_FOUND
        array.remove(freshCandidateIndexes, candidateIndex)

addLevel(Level level) =>
    int levelIndex = array.size(allLevels)
    array.push(allLevels, level)
    queueDirtyRender(levelIndex)

    if level.fresh
        queueFreshCandidate(levelIndex)

    if level.levelType == LEVEL_CLASSIC
        queueBOCandidate(levelIndex)

    if level.levelType == LEVEL_BO
        queueHNSCandidate(levelIndex)

// ---------------------------------------------------------------------------
// Lifecycle
// ---------------------------------------------------------------------------

checkLevelTouch(Level level) =>
    bool touched = false

    if bar_index > level.creationBar
        touched := isLevelTouched(level)

    touched

updateLevels() =>
    int candidateCount = array.size(freshCandidateIndexes)

    if candidateCount > 0
        int candidateIndex = candidateCount - INDEX_STEP

        while candidateIndex >= FIRST_LEVEL_ID
            int levelIndex = array.get(freshCandidateIndexes, candidateIndex)
            Level level = array.get(allLevels, levelIndex)

            if checkLevelTouch(level)
                level.fresh := false
                array.set(allLevels, levelIndex, level)
                queueDirtyRender(levelIndex)
                array.remove(freshCandidateIndexes, candidateIndex)

            candidateIndex -= INDEX_STEP

markBOCreated(array<Level> levels, array<int> boCandidates, int sourceIndex) =>
    Level level = array.get(levels, sourceIndex)
    level.boCreated := true
    level.valid := false
    array.set(levels, sourceIndex, level)
    queueDirtyRender(sourceIndex)
    removeFreshCandidate(sourceIndex)

    int candidateIndex = array.indexof(boCandidates, sourceIndex)

    if candidateIndex != INDEX_NOT_FOUND
        array.remove(boCandidates, candidateIndex)

markHNSCreated(array<Level> levels, array<int> hnsCandidates, int sourceIndex) =>
    Level level = array.get(levels, sourceIndex)
    level.hnsCreated := true
    level.valid := false
    array.set(levels, sourceIndex, level)
    queueDirtyRender(sourceIndex)
    removeFreshCandidate(sourceIndex)

    int candidateIndex = array.indexof(hnsCandidates, sourceIndex)

    if candidateIndex != INDEX_NOT_FOUND
        array.remove(hnsCandidates, candidateIndex)

// ---------------------------------------------------------------------------
// Renderer
// ---------------------------------------------------------------------------

var array<line> levelLines = array.new<line>()
var array<bool> renderedLevels = array.new<bool>()
var array<label> levelTextLabels = array.new<label>()

getLevelColor(int direction) =>
    direction == SUPPORT ? SUPPORT_COLOR : RESISTANCE_COLOR

ensureLineCapacity(array<line> lines, int requiredSize) =>
    while array.size(lines) < requiredSize
        array.push(lines, na)

ensureLabelCapacity(array<label> labels, int requiredSize) =>
    while array.size(labels) < requiredSize
        array.push(labels, na)

ensureRenderedCapacity(array<bool> rendered, int requiredSize) =>
    while array.size(rendered) < requiredSize
        array.push(rendered, false)

getLevelTypeText(int levelType) =>
    string levelTypeText = "?"

    if levelType == LEVEL_CLASSIC
        levelTypeText := "Classic"
    else if levelType == LEVEL_BO
        levelTypeText := "BO"
    else if levelType == LEVEL_GAP
        levelTypeText := "GAP"
    else if levelType == LEVEL_HNS
        levelTypeText := "HNS"

    levelTypeText

getDirectionText(int direction) =>
    string directionText = "?"

    if direction == SUPPORT
        directionText := "S"
    else if direction == RESISTANCE
        directionText := "R"

    directionText

getLevelText(Level level) =>
    getLevelTypeText(level.levelType) + "-" + getDirectionText(level.direction)

shouldRenderLevel(Level level) =>
    level.valid and level.fresh

renderLevel(Level level, array<line> lines, array<bool> rendered, array<label> textLabels) =>
    int lineIndex = level.id

    ensureLineCapacity(lines, lineIndex + LINE_END_OFFSET)
    ensureRenderedCapacity(rendered, lineIndex + LINE_END_OFFSET)
    ensureLabelCapacity(textLabels, lineIndex + LINE_END_OFFSET)

    bool alreadyRendered = array.get(rendered, lineIndex)
    line levelLine = array.get(lines, lineIndex)
    label textLabel = array.get(textLabels, lineIndex)
    bool displayLevel = shouldRenderLevel(level)
    color levelColor = getLevelColor(level.direction)

    if displayLevel and not alreadyRendered
        levelLine := line.new(
             level.creationBar,
             level.price,
             bar_index + LINE_DISPLAY_OFFSET,
             level.price,
             xloc = xloc.bar_index,
             color = levelColor,
             width = LEVEL_LINE_WIDTH)
        textLabel := label.new(
             bar_index + TEXT_LABEL_OFFSET,
             level.price,
             text = getLevelText(level),
             xloc = xloc.bar_index,
             style = label.style_none,
             color = color.new(color.white, 100),
             textcolor = levelColor,
             size = size.small)
        array.set(lines, lineIndex, levelLine)
        array.set(textLabels, lineIndex, textLabel)
        array.set(rendered, lineIndex, true)
    else if displayLevel and alreadyRendered and not na(textLabel)
        if not na(levelLine)
            line.set_x2(levelLine, bar_index + LINE_DISPLAY_OFFSET)
        label.set_x(textLabel, bar_index + TEXT_LABEL_OFFSET)
        label.set_y(textLabel, level.price)
        label.set_text(textLabel, getLevelText(level))
        label.set_textcolor(textLabel, levelColor)
    else if not displayLevel and not na(levelLine)
        line.delete(levelLine)
        if not na(textLabel)
            label.delete(textLabel)
        array.set(lines, lineIndex, na)
        array.set(textLabels, lineIndex, na)
        array.set(rendered, lineIndex, false)

renderDirtyLevels(array<Level> levels, array<int> dirtyIndexes, array<line> lines, array<bool> rendered, array<label> textLabels) =>
    int dirtyCount = array.size(dirtyIndexes)

    if dirtyCount > 0
        for dirtyIndex = FIRST_LEVEL_ID to dirtyCount - INDEX_STEP
            int levelIndex = array.get(dirtyIndexes, dirtyIndex)
            Level level = array.get(levels, levelIndex)
            renderLevel(level, lines, rendered, textLabels)

        array.clear(dirtyIndexes)

// ---------------------------------------------------------------------------
// Main
// ---------------------------------------------------------------------------

if barstate.isconfirmed
    updateLevels()

    [detected, levelPrice, direction, levelType] = detectClassic()

    if detected
        Level level = createLevel(nextId, levelPrice, direction, levelType, bar_index)
        addLevel(level)
        nextId += 1

    [gapDetected, gapPrice, gapDirection, gapLevelType] = detectGap()

    if gapDetected
        Level gapLevel = createLevel(nextId, gapPrice, gapDirection, gapLevelType, bar_index)
        addLevel(gapLevel)
        nextId += 1

    detectBO(allLevels, boCandidateIndexes, boCreationPrices, boCreationDirections, boCreationSourceIndexes, boCreationBars)

    int boCreationCount = array.size(boCreationPrices)

    if boCreationCount > 0
        for boCreationIndex = FIRST_LEVEL_ID to boCreationCount - INDEX_STEP
            float boPrice = array.get(boCreationPrices, boCreationIndex)
            int boDirection = array.get(boCreationDirections, boCreationIndex)
            int boSourceIndex = array.get(boCreationSourceIndexes, boCreationIndex)
            int boCreationBar = array.get(boCreationBars, boCreationIndex)
            Level boLevel = createLevel(nextId, boPrice, boDirection, LEVEL_BO, boCreationBar)

            markBOCreated(allLevels, boCandidateIndexes, boSourceIndex)
            addLevel(boLevel)
            nextId += 1

    detectHNS(allLevels, hnsCandidateIndexes, hnsCreationPrices, hnsCreationDirections, hnsCreationSourceIndexes, hnsCreationBars)

    int hnsCreationCount = array.size(hnsCreationPrices)

    if hnsCreationCount > 0
        for hnsCreationIndex = FIRST_LEVEL_ID to hnsCreationCount - INDEX_STEP
            float hnsPrice = array.get(hnsCreationPrices, hnsCreationIndex)
            int hnsDirection = array.get(hnsCreationDirections, hnsCreationIndex)
            int hnsSourceIndex = array.get(hnsCreationSourceIndexes, hnsCreationIndex)
            int hnsCreationBar = array.get(hnsCreationBars, hnsCreationIndex)
            Level hnsLevel = createLevel(nextId, hnsPrice, hnsDirection, LEVEL_HNS, hnsCreationBar)

            markHNSCreated(allLevels, hnsCandidateIndexes, hnsSourceIndex)
            addLevel(hnsLevel)
            nextId += 1

renderDirtyLevels(allLevels, dirtyRenderIndexes, levelLines, renderedLevels, levelTextLabels)

plot(na, title = "EQ Engine Compile Anchor", display = display.none)
